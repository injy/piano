@import 'styl/variables'
@import 'styl/base'
@import 'styl/typography'
@import 'styl/container'
@import 'styl/main'
@import 'styl/piano'

// --------------------------------------------------
// Sound Selector
// --------------------------------------------------

.sound-selector
  position fixed
  top 1rem
  left 1rem
  display flex
  gap 0.5rem
  z-index 100
  flex-wrap wrap
  max-width 200px
  
  button
    padding 0.4rem 0.8rem
    border 1px solid $gray-medium
    border-radius 4px
    background $white
    color $gray-dark
    font-size 0.75rem
    cursor pointer
    transition all 0.2s ease
    
    &:hover
      background $gray-lighter
      border-color $gray-dark
    
    &.active
      background $gray-dark
      color $white
      border-color $gray-dark

// --------------------------------------------------
// Landscape Button (Mobile)
// --------------------------------------------------

.landscape-btn
  position fixed
  top 1rem
  right 1rem
  padding 0.5rem 1rem
  border 1px solid $gray-medium
  border-radius 4px
  background $white
  color $gray-dark
  font-size 0.8rem
  cursor pointer
  z-index 100
  display none
  align-items center
  gap 0.4rem
  transition all 0.2s ease
  
  svg
    width 18px
    height 18px
  
  &:hover
    background $gray-lighter
    border-color $gray-dark
  
  @media (min-width: $screen-sm)
    display none !important

// --------------------------------------------------
// Landscape Mode (Mobile)
// --------------------------------------------------

body.landscape-mode
  position fixed
  top 0
  left 0
  width 100vw
  height 100vh
  overflow hidden
  background $gray-dark
  
  // 隐藏正文内容
  .main, .content
    display none
  
  // 钢琴占满屏幕
  .header
    position fixed
    top 50%
    left 50%
    transform translate(-50%, -50%) rotate(90deg)
    transform-origin center center
    width 100vh
    height auto
    padding 1rem
    box-sizing border-box
  
  // 钢琴键盘占满
  .piano
    height 100vh
    width 100vw
    padding 0.5rem
    box-sizing border-box
  
  // 音色选择器 - 竖屏时在右下角
  .sound-selector
    top auto
    left auto
    bottom 10px
    right 10px
    transform rotate(-90deg)
    transform-origin right bottom
  
  // 横屏按钮 - 竖屏时在左下角
  .landscape-btn
    top auto
    left 10px
    bottom 10px
    right auto
    transform rotate(-90deg)
    transform-origin left bottom





