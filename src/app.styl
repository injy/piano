@import 'styl/variables'
@import 'styl/base'
@import 'styl/typography'
@import 'styl/container'
@import 'styl/main'
@import 'styl/piano'

// --------------------------------------------------
// Sound Selector
// --------------------------------------------------

.sound-selector
  position fixed
  top 1rem
  left 1rem
  display flex
  gap 0.5rem
  z-index 100
  flex-wrap wrap
  max-width 200px
  
  button
    padding 0.4rem 0.8rem
    border 1px solid $gray-medium
    border-radius 4px
    background $white
    color $gray-dark
    font-size 0.75rem
    cursor pointer
    transition all 0.2s ease
    
    &:hover
      background $gray-lighter
      border-color $gray-dark
    
    &.active
      background $gray-dark
      color $white
      border-color $gray-dark

// --------------------------------------------------
// Landscape Button (Mobile)
// --------------------------------------------------

.landscape-btn
  position fixed
  top 1rem
  right 1rem
  padding 0.5rem 1rem
  border 1px solid $gray-medium
  border-radius 4px
  background $white
  color $gray-dark
  font-size 0.8rem
  cursor pointer
  z-index 100
  display none
  align-items center
  gap 0.4rem
  transition all 0.2s ease
  
  svg
    width 18px
    height 18px
  
  &:hover
    background $gray-lighter
    border-color $gray-dark
  
  @media (min-width: $screen-sm)
    display none !important


