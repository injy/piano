@import 'styl/variables'
@import 'styl/base'
@import 'styl/typography'
@import 'styl/container'
@import 'styl/main'
@import 'styl/piano'

// --------------------------------------------------
// Sound Selector
// --------------------------------------------------

.sound-selector
  position fixed
  top 1rem
  left 1rem
  display flex
  gap 0.5rem
  z-index 100
  flex-wrap wrap
  max-width 200px
  
  button
    padding 0.4rem 0.8rem
    border 1px solid $gray-medium
    border-radius 4px
    background $white
    color $gray-dark
    font-size 0.75rem
    cursor pointer
    transition all 0.2s ease
    
    &:hover
      background $gray-lighter
      border-color $gray-dark
    
    &.active
      background $gray-dark
      color $white
      border-color $gray-dark

// --------------------------------------------------
// Landscape Button (Mobile)
// --------------------------------------------------

.landscape-btn
  position fixed
  top 1rem
  right 1rem
  padding 0.5rem 1rem
  border 1px solid $gray-medium
  border-radius 4px
  background $white
  color $gray-dark
  font-size 0.8rem
  cursor pointer
  z-index 100
  display none
  align-items center
  gap 0.4rem
  transition all 0.2s ease
  
  svg
    width 18px
    height 18px
  
  &:hover
    background $gray-lighter
    border-color $gray-dark
  
  @media (min-width: $screen-sm)
    display none !important

// --------------------------------------------------
// Landscape Mode (Mobile)
// 用户逆时针旋转手机，body 整体顺时针旋转90度补偿
// --------------------------------------------------

body.landscape-mode
  position fixed
  top 0
  left 0
  width 100vw
  height 100vh
  overflow hidden
  background $gray-dark
  transform rotate(90deg)
  transform-origin left top

  // 隐藏正文内容
  .main, .content
    display none

  // 钢琴容器 - 不旋转，保持正常显示
  .header
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    width 100vh
    height auto

  // 钢琴键盘 - 适应旋转后的视口
  .piano
    height calc(100vw - 2rem)
    max-height 100vh
    width calc(100vh - 2rem)
    max-width 100vw
    padding 0.5rem
    box-sizing border-box

  // 音色选择器 - 保持用户左上角（不旋转）
  .sound-selector
    position absolute
    top 10px
    left 10px
    transform none

  // 横屏按钮 - 保持用户右上角（不旋转）
  .landscape-btn
    position absolute
    top 10px
    right 10px
    transform none









