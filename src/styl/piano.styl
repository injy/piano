// ==================================================
// Piano
// ==================================================

// @stylint off
.piano
  background linear-gradient(-65deg, #000, #222, #000, #666, #222 75%)
  border-top $space-xs $gray-darker solid
  box-shadow inset 0 -1px 1px rgba($white, .5), inset 0 -($space-xxs) $space-xxs $gray-darker
  display flex
  height 80vh
  justify-content center
  overflow hidden
  padding-bottom 5%
  padding-left 2.5%
  padding-right 2.5%

  @media screen and (min-height: 440px)
    height $piano-height

  &-key
    flex 1
    margin 0 ($space-xxs / 4)
    max-width $space-xxlg
    position relative

    // Hidden keys on extra small screens
    @media screen and (max-width: 379px)
      &:nth-child(1),
      &:nth-child(2),
      &:nth-child(3),
      &:nth-child(11),
      &:nth-child(12),
      &:nth-child(13),
      &:nth-child(14)
        display none

    &__white
      background linear-gradient(-30deg, #f8f8f8, #fff)
      box-shadow inset 0 1px 0px rgba(255,255,255, 1),inset 0 -1px 0px rgba(255,255,255, 1),inset 1px 0px 0px rgba(255,255,255, 1),inset -1px 0px 0px rgba(255,255,255, 1),0 4px 3px rgba(0,0,0,.7),inset 0 -1px 0px rgba(255,255,255, 1),inset 1px 0px 0px rgba(255,255,255, 1),inset -1px -1px 15px rgba(0,0,0, .5), -3px 4px 6px rgba(0,0,0, .5)
      height 100%
      position relative

      &:active,
      &.active
        box-shadow inset 0 1px 0px rgba(255,255,255, 1),inset 0 -1px 0px rgba(255,255,255, 1),inset 1px 0px 0px rgba(255,255,255, 1),inset -1px 0px 0px rgba(255,255,255, 1),0 4px 3px rgba(0,0,0,.7),inset 0 -1px 0px rgba(255,255,255, 1),inset 1px 0px 0px rgba(255,255,255, 1),inset -1px -1px 15px rgba(0,0,0, 1), -3px 4px 6px rgba(0,0,0, .5)
        height 'calc(%s)' % (100% - $space-xxs)
        position relative
        top -($space-xxs)

    &__black
      background linear-gradient(-20deg,#222,#000,#222)
      box-shadow inset 0px -1px 2px rgba(255,255,255,.4),0 2px 3px rgba(0,0,0,.4)
      border-width ($space-xxs / 2) $space-xxs ($space-xs + $space-xxs)
      border-style solid
      border-color #666 #222 #111 #555
      height 75%
      left 100%
      position absolute
      transform translateX(-50%)
      top 0
      width 70%
      z-index $zindex-piano

      &:active,
      &.active
        border-bottom-width $space-xxs

// 琴键音调标签
.key-label
  position absolute
  bottom 0.5rem
  left 50%
  transform translateX(-50%)
  font-size 3rem
  font-weight bold
  color $gray-dark
  pointer-events none
  user-select none
  display flex
  flex-direction column
  align-items center

.piano-key__black .key-label
  color $gray-lighter
  bottom 0.3rem
  font-size 2.5rem

// 高音点（在上方）
.dot-top-label
  font-size 2.2rem
  line-height 1
  margin-bottom -0.5rem

// 低音点（在下方）
.dot-bottom-label
  font-size 2.2rem
  line-height 1
  margin-top -0.5rem

// 横屏模式下音调标签
body.landscape-mode .key-label
  font-size 4.5rem

body.landscape-mode .piano-key__black .key-label
  font-size 3.5rem

body.landscape-mode .dot-top-label
  font-size 3rem

body.landscape-mode .dot-bottom-label
  font-size 3rem

// ==================================================
// 简谱展示层 - 覆盖在键盘上方 1/3 区域
// ==================================================

.sheet-music
  position absolute
  top 0
  left 0
  width 100%
  height 35%
  background linear-gradient(to bottom, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 80%, rgba(255, 255, 255, 0) 100%)
  overflow visible
  pointer-events none
  z-index 10

.sheet-music-track
  width 100%
  height 100%
  overflow hidden
  position relative
  // 隐藏滚动条
  &::-webkit-scrollbar
    display none
  scrollbar-width none

.sheet-music-content
  display flex
  flex-direction column
  align-items center
  gap 1rem
  padding 0
  border 0
  animation scroll-notes-vertical linear infinite
  animation-duration 20s // 默认值，会被 JS 动态覆盖

// 每行4个音符
.note-row
  display flex
  gap 1rem
  flex-shrink 0

.sheet-music-content .note
  display inline-flex
  align-items center
  justify-content center
  width 40px
  height 40px
  border-radius 50%
  background rgba(0, 0, 0, 0.8)
  color $white
  font-size 1.4rem
  font-weight bold
  flex-shrink 0
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.3)
  position relative

// 高音加点（点在数字上方）
.note .dot-top
  &::before
    content ''
    position absolute
    top 4px
    left 50%
    transform translateX(-50%)
    width 6px
    height 6px
    border-radius 50%
    background $white

// 低音加点（点在数字下方）
.note .dot-bottom
  position absolute
  bottom 2px
  left 50%
  transform translateX(-50%)
  font-size 0.6rem
  line-height 1

@keyframes scroll-notes-vertical
  0%
    transform translateY(0)
  100%
    transform translateY(-100%)

// 横屏模式下简谱层保持相对位置（跟着钢琴旋转）
body.landscape-mode .sheet-music
  height 25%
  z-index 50

body.landscape-mode .sheet-music-content .note
  width 60px
  height 60px
  font-size 2.2rem

// @stylint on
